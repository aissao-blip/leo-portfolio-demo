# Leo Portfolio Demo — example configuration.
# Copy to .env and edit. Everything here is optional; the demo runs with none
# of it set.
#
# This file must never contain a real key. .env is gitignored.

# Port the demo serves on.
PORT=5055

# "simulated" (default) or "live".
#   simulated  rule-based, deterministic, no network, no key, no cost
#   live       calls Anthropic to write the reply drafts, using the key below
LEO_DEMO_AI_MODE=simulated

# Only read when LEO_DEMO_AI_MODE=live. Get one at console.anthropic.com.
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# LEO_DEMO_MODEL=claude-opus-4-7
